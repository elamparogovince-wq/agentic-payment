DEVICE_HASH=replace_with_64_character_sha256_hex
AGENT_SECRET=S_replace_with_testnet_agent_secret
MERCHANT_ADDRESS=G_replace_with_testnet_merchant_public_address
ASSET_CONTRACT_ID=C_replace_with_testnet_token_contract_id
PAYMENT_AMOUNT=2.00
# Optional: lets the web page and `npm run merchant:claim` collect the pending balance as the merchant (Testnet only).
MERCHANT_SECRET=
# Seed for the simulated cold-chain tag. Set any long random string; keep it private. Needed for `npm run device:send`.
DEVICE_SIM_SEED=
# Where the SQLite database lives. Defaults to ./data. On Render, point this at a persistent disk.
DATA_DIR=
PAYMENT_ASSET_LABEL=USDC
VELO_API_KEY=
VELO_WEBHOOK_SECRET=
VELO_CHECKOUT_ASSET=USDC
VELO_CHECKOUT_AMOUNT=1.00
APP_BASE_URL=http://localhost:5173
PORT=4173
